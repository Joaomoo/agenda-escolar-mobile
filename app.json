{
  "expo": {
    "name": "Agenda Escolar CIM",
    "slug": "agenda-escolar-cim",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cimagenda",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seuprojeto.agendaescolarcim"
    },
    "android": {
      "package": "com.seuprojeto.agendaescolarcim",
      "adaptiveIcon": {
        "backgroundColor": "#F4F6FB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b955093-98b9-4b3a-955a-36cb9bd4e9b0"
      }
    }
  }
}
